&CONTROL
  calculation = 'relax'
  prefix = 'bto_2x2x2_perfect'
  outdir = './tmp'
  pseudo_dir ='/home/kylay/scratch/BTO/pseuds'
  tstress = .true.
  tprnfor = .true.
  etot_conv_thr = 1.0d-4  ! Ry
  forc_conv_thr = 1.0d-3  ! Ry/au
  nstep = 500
/
&SYSTEM
  ibrav = 0
  nat = 40
  ntyp = 3
  ecutwfc = 60
  ecutrho = 600
  occupations = 'smearing'
  smearing = 'mv'
  degauss = 0.005
/
&ELECTRONS
  conv_thr = 1.0d-6
  mixing_beta = 0.4
  mixing_mode = 'plain'
  mixing_ndim = 16
  electron_maxstep = 1000
  diagonalization = 'david'
/
&IONS
/
